# Copy to agent/.env. Keep real credentials out of version control.
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY
MODEL=qwen-plus
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
REDIS_URL=redis://127.0.0.1:16379
REDIS_TTL=1800
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19531
MILVUS_API_KEY=
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-your-neo4j-password
NEO4J_DATABASE=neo4j
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_USER=cloudagent
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_DATABASE=cloud_platform
LOG_LEVEL=INFO
CLOUDAGENT_OPERATOR_ID=user_1001
# Optional neural reranker. Leave empty to disable.
RERANK_MODEL=
# Optional read-only Alibaba Cloud integration.
ALIYUN_REGIONS=cn-beijing
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
