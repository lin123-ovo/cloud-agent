# Copy to .env.docker and replace every password before first startup.
# MYSQL_PASSWORD and NEO4J_PASSWORD in agent/.env must match these values.
CLOUDAGENT_MYSQL_ROOT_PASSWORD=replace-with-your-root-password
CLOUDAGENT_MYSQL_PASSWORD=replace-with-your-mysql-password
CLOUDAGENT_NEO4J_PASSWORD=replace-with-your-neo4j-password
CLOUDAGENT_MINIO_USER=cloudagent-local
CLOUDAGENT_MINIO_PASSWORD=replace-with-your-minio-password
